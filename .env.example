# Required for a playable game. The app still builds and shows
# "服务器未配置，暂时无法开局。" when this is missing.
ZENMUX_API_KEY=

# Optional. When both are set, the daily IP counter and the
# per-game LLM cap are stored in Upstash Redis / Vercel KV and survive
# serverless cold starts. Without them, limits are enforced in memory
# on each instance, with a signed browser cookie as a best-effort backup.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. Games one IP may start per Asia/Singapore calendar day.
# Positive integer. Missing or invalid values use 3.
# DAILY_GAME_LIMIT=3

# Optional QA bypass for the daily IP cap. Leave unset in public deploys.
# When set, opening /?tester=<this value> stores it in localStorage and
# later game-start requests send it as the X-Tester-Token header.
# A match skips only the per-IP daily limit. The per-game LLM call cap stays.
# RATE_LIMIT_BYPASS_TOKEN=

# Optional absolute origin for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://example.com
